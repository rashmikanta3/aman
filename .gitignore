# Environment secrets & credentials (CRITICAL: prevents leaking API keys/passwords)
.env
.env.*
*.env
service-account*.json
credentials.json
client_secret*.json

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Local databases (SQLite / temporary dumps)
*.sqlite
*.sqlite3
*.db
attendance.db

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Local upload or log artifacts
*.log
uploads/
temp/
tmp/